# =============================================================================
# Android / Gradle
# =============================================================================

# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
.kotlin/
build/

# Signing files (keep keystores/passwords out of version control!)
*.jks
*.keystore
*.p12
*.pkcs12
!debug.keystore
keystore.properties
bugfender.properties
# Firebase client configuration is provisioned locally / through GitHub Actions secrets.
google-services.json

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio
*.iml
.idea/
*.iws

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/codeStyles
.idea/modules.xml
.idea/*.iml
.idea/navEditor.xml
.idea/deploymentTargetSelector.xml

# External native build folder generated in Android Studio 2.2+
.externalNativeBuild/
.cxx/

# CMake
cmake-build-*/

# NDK
*.o
*.obj

# Misc
.DS_Store
Thumbs.db

# Test recordings and source tracks used for capture forensics (tools/audio). Keep them local.
*.wav
*.flac
samples/

# =============================================================================
# Third-party source — intentionally NOT vendored
# =============================================================================

# Pioneer DJM-A9 Windows driver — proprietary, not part of this Android app.
# These files were used for reverse-engineering the USB control protocol only.
# Do not commit them to the open-source repository.
windows_driver/
research_drivers/

# =============================================================================
# IDE-specific
# =============================================================================
.vscode/

# Fork release signing material (keystore + password), never committed.
release-signing/
