<?xml version="1.0" encoding="utf-8"?>
<!--
    Match standard UAC devices plus every AlphaTheta / Pioneer DJ (vendor 0x2B73 = 11123)
    device. Several DJM mixers hide their audio behind a vendor-specific interface class, so a
    class="1" filter alone would never launch the app for them; matching the whole vendor also
    covers models whose product IDs are not yet known (e.g. DJM-V5 variants).
    Fine-grained interface/endpoint validation still happens in UsbAudioManager.
-->
<resources>
    <usb-device class="1" />
    <usb-device vendor-id="11123" />  <!-- AlphaTheta / Pioneer DJ: DJM-900NXS2 (10), DJM-450 (19),
                                           DJM-750MK2 (27), DJM-V10 (52), DJM-S11 (55), DJM-A9 (60),
                                           DJM-V5 (88-91, unverified), XDJ-XZ (45), XDJ-RX3 (61),
                                           OPUS-QUAD (67), OMNIS-DUO (72), XDJ-AZ (74) -->
</resources>
